From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pufferfish <pufferfish@localhost>
Date: Sun, 20 Sep 2026 00:00:00 +0100
Subject: [PATCH] Pufferfish: Process async path points in Paper API

Use Path accessors when exposing points so AsyncPath completes before the
Paper pathfinding API returns its point list.

diff --git a/src/main/java/com/destroystokyo/paper/entity/PaperPathfinder.java b/src/main/java/com/destroystokyo/paper/entity/PaperPathfinder.java
--- a/src/main/java/com/destroystokyo/paper/entity/PaperPathfinder.java
+++ b/src/main/java/com/destroystokyo/paper/entity/PaperPathfinder.java
@@ -123,8 +123,9 @@ public class PaperPathfinder implements com.destroystokyo.paper.entity.Pathfinder {
         @Override
         public List<Location> getPoints() {
             List<Location> points = new ArrayList<>();
-            for (Node point : this.path.nodes) {
+            for (int i = 0; i < this.path.getNodeCount(); i++) {
+                Node point = this.path.getNode(i);
                 points.add(CraftLocation.toBukkit(point, PaperPathfinder.this.entity.level()));
             }
             return points;
         }

diff --git a/net/minecraft/util/SpecialDates.java b/net/minecraft/util/SpecialDates.java
index a6018d9fba0957fc721cebc9f366767fa04d4950..b84d08d4689a40e2892e069628db141020978e4c 100644
--- a/net/minecraft/util/SpecialDates.java
+++ b/net/minecraft/util/SpecialDates.java
@@ -17,9 +17,18 @@ public class SpecialDates {
         return MonthDay.from(ZonedDateTime.now());
     }
 
+    // Pufferfish start - only check for spooky season once an hour
+    private static boolean isSpookySeason = false;
+    private static final int ONE_HOUR = 20 * 60 * 60;
+    private static int lastSpookyCheck = -ONE_HOUR;
     public static boolean isHalloween() {
-        return HALLOWEEN.equals(dayNow());
+        if (net.minecraft.server.MinecraftServer.currentTick - lastSpookyCheck > ONE_HOUR) {
+            isSpookySeason = HALLOWEEN.equals(dayNow());
+            lastSpookyCheck = net.minecraft.server.MinecraftServer.currentTick;
+        }
+        return isSpookySeason;
     }
+    // Pufferfish end
 
     public static boolean isExtendedChristmas() {
         return CHRISTMAS_RANGE.contains(dayNow());

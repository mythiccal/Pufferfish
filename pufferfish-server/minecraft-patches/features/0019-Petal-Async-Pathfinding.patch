+    // Pufferfish start - Async Pathfinding
+    private record PendingPath(Path path, Set<Pair<Holder<PoiType>, BlockPos>> pois) {}
+
+    private static void applyPathResult(final Predicate<Holder<PoiType>> poiType,
+                                        final Optional<Byte> onPoiAcquisitionEvent,
+                                        final Long2ObjectMap<AcquirePoi.JitteredLinearRetry> batchCache,
+                                        final net.minecraft.world.entity.ai.behavior.declarative.MemoryAccessor<com.mojang.datafixers.kinds.Const.Mu<com.mojang.datafixers.util.Unit>, GlobalPos> toAcquire,
+                                        final ServerLevel level,
+                                        final PathfinderMob body,
+                                        final long timestamp,
+                                        final PoiManager poiManager,
+                                        final Set<Pair<Holder<PoiType>, BlockPos>> poiPositions,
+                                        final @Nullable Path path) {
+        if (path != null && path.canReach()) {
+            BlockPos targetPos = path.getTarget();
+            if (poiManager.getType(targetPos).isPresent()
+                && poiManager.take(poiType, (type, poiPos) -> poiPos.equals(targetPos), targetPos, 1).isPresent()) {
+                toAcquire.set(GlobalPos.of(level.dimension(), targetPos));
+                onPoiAcquisitionEvent.ifPresent(event -> level.broadcastEntityEvent(body, event));
+                batchCache.clear();
+                level.debugSynchronizers().updatePoi(targetPos);
+                return;
+            }
+        }
+
+		for (Pair<Holder<PoiType>, BlockPos> candidate : poiPositions) {
+			batchCache.computeIfAbsent(candidate.getSecond().asLong(), key -> new JitteredLinearRetry(level.getRandom(), timestamp));
+		}
+    }
+    // Pufferfish end - Async Pathfinding
+
     public static @Nullable Path findPathToPois(final Mob body, final Set<Pair<Holder<PoiType>, BlockPos>> pois) {
         if (pois.isEmpty()) {
             return null;

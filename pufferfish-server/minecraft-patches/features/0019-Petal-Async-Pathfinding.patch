+    private void beginRequest(final WalkTarget walkTarget) {
+        if (this.path instanceof gg.pufferfish.pufferfish.async.pathfinding.AsyncPath asyncPath && !asyncPath.isProcessed()) {
+            asyncPath.cancel();
+        }
+        this.requestGeneration++;
+        this.pathGeneration = this.requestGeneration;
+        this.requestPath = this.path;
+        this.requestedWalkTarget = walkTarget;
+        this.requestedTarget = walkTarget.getTarget();
+    }
+
+    private boolean matchesRequest(final WalkTarget walkTarget) {
+        if (this.requestedWalkTarget == walkTarget && this.requestedTarget == walkTarget.getTarget()) {
+            return true;
+        }
+        // Vanilla OneShots replace WalkTarget every tick; only re-path when the destination moved > 2 blocks
+        if (this.lastTargetPos != null
+            && walkTarget.getTarget().currentBlockPosition().distSqr(this.lastTargetPos) <= 4.0) {
+            this.requestedWalkTarget = walkTarget;
+            this.requestedTarget = walkTarget.getTarget();
+            return true;
+        }
+        return false;
+    }
+
+    private void invalidateRequest() {
+        this.requestGeneration++;
+        this.pathGeneration = this.requestGeneration;
+        if (this.path instanceof gg.pufferfish.pufferfish.async.pathfinding.AsyncPath asyncPath) {
+            asyncPath.cancel();
+        }
+        this.path = null;
+        this.requestPath = null;
+        this.finishedProcessing = true;
+        this.requestedWalkTarget = null;
+        this.requestedTarget = null;
+        this.lastTargetPos = null;
+    }
+
     private boolean reachedTarget(final Mob body, final WalkTarget walkTarget) {
         return walkTarget.getTarget().currentBlockPosition().distManhattan(body.blockPosition()) <= walkTarget.getCloseEnoughDist();
     }

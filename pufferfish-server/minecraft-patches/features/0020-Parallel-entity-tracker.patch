+    public final boolean pufferfish$lastPassengersContainsPlayer() {
+        final java.util.List<?> lastPassengers = this.lastPassengers;
+        for (int i = 0, size = lastPassengers.size(); i < size; ++i) {
+            if (lastPassengers.get(i) instanceof ServerPlayer) {
+                return true;
+            }
+        }
+        return false;
+    }

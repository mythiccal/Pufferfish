diff --git a/net/minecraft/world/item/crafting/ShapelessRecipe.java b/net/minecraft/world/item/crafting/ShapelessRecipe.java
index 53a818f..eb60e54 100644
--- a/net/minecraft/world/item/crafting/ShapelessRecipe.java
+++ b/net/minecraft/world/item/crafting/ShapelessRecipe.java
@@ -2,6 +2,7 @@ package net.minecraft.world.item.crafting;
 
 import com.mojang.serialization.MapCodec;
 import com.mojang.serialization.codecs.RecordCodecBuilder;
+import com.google.common.collect.Lists; // Pufferfish
 import java.util.List;
 import net.minecraft.network.RegistryFriendlyByteBuf;
 import net.minecraft.network.codec.ByteBufCodecs;
@@ -38,14 +39,24 @@ public class ShapelessRecipe extends NormalCraftingRecipe {
     public static final RecipeSerializer<ShapelessRecipe> SERIALIZER = new RecipeSerializer<>(MAP_CODEC, STREAM_CODEC);
     private final ItemStackTemplate result;
     private final List<Ingredient> ingredients;
+    private final boolean isBukkit; // Pufferfish
 
+    // Pufferfish start
     public ShapelessRecipe(
         final Recipe.CommonInfo commonInfo, final CraftingRecipe.CraftingBookInfo bookInfo, final ItemStackTemplate result, final List<Ingredient> ingredients
+    ) {
+        this(commonInfo, bookInfo, result, ingredients, false);
+    }
+
+    public ShapelessRecipe(
+        final Recipe.CommonInfo commonInfo, final CraftingRecipe.CraftingBookInfo bookInfo, final ItemStackTemplate result, final List<Ingredient> ingredients, final boolean isBukkit
     ) {
         super(commonInfo, bookInfo);
         this.result = result;
         this.ingredients = ingredients;
+        this.isBukkit = isBukkit;
     }
+    // Pufferfish end
 
     // CraftBukkit start
     @Override
@@ -74,6 +85,28 @@ public class ShapelessRecipe extends NormalCraftingRecipe {
 
     @Override
     public boolean matches(final CraftingInput input, final Level level) {
+        // Pufferfish start
+        if (!this.isBukkit) {
+            List<Ingredient> ingredients = Lists.newArrayList(this.ingredients);
+
+            inventory:
+            for (int index = 0; index < input.size(); index++) {
+                ItemStack itemStack = input.getItem(index);
+
+                if (!itemStack.isEmpty()) {
+                    for (int i = 0; i < ingredients.size(); i++) {
+                        if (ingredients.get(i).test(itemStack)) {
+                            ingredients.remove(i);
+                            continue inventory;
+                        }
+                    }
+                    return false;
+                }
+            }
+
+            return ingredients.isEmpty();
+        }
+        // Pufferfish end
         // Paper start - Improve exact choice recipe ingredients & unwrap ternary
         if (input.ingredientCount() != this.ingredients.size()) {
             return false;

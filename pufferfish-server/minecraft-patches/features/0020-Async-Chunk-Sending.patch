+    // Pufferfish start - Async Chunk Sending
+    public ClientboundLevelChunkWithLightPacket(LevelChunk chunk, LevelLightEngine lightEngine) {
+        ChunkPos chunkPos = chunk.getPos();
+        this.x = chunkPos.x();
+        this.z = chunkPos.z();
+        net.minecraft.world.level.chunk.LevelChunkSection[] sections = chunk.getSections();
+        net.minecraft.world.level.chunk.LevelChunkSection[] sectionSnapshot = new net.minecraft.world.level.chunk.LevelChunkSection[sections.length];
+        for (int i = 0; i < sections.length; ++i) {
+            sectionSnapshot[i] = sections[i].copy();
+        }
+        this.chunkData = new ClientboundLevelChunkPacketData(chunk, sectionSnapshot);
+        this.lightData = new ClientboundLightUpdatePacketData(chunkPos, lightEngine, null, null);
+    }
+
+    public void finishAsyncSerialization() {
+        this.chunkData.serializeFromSnapshot();
+        this.setReady(true);
+    }
+    // Pufferfish end - Async Chunk Sending
+
     private ClientboundLevelChunkWithLightPacket(final RegistryFriendlyByteBuf input) {
         this.x = input.readInt();
         this.z = input.readInt();
diff --git a/net/minecraft/server/network/PlayerChunkSender.java b/net/minecraft/server/network/PlayerChunkSender.java
index 196c01fe5f200ed57e6f23e0939cac616305571a..6e774e20fa8ce7c006e7df4a09fd9b48872471d3 100644
--- a/net/minecraft/server/network/PlayerChunkSender.java
+++ b/net/minecraft/server/network/PlayerChunkSender.java
@@ -81,7 +81,22 @@ public class PlayerChunkSender {
     public static void sendChunk(final ServerGamePacketListenerImpl connection, final ServerLevel level, final LevelChunk chunk) { // Paper - rewrite chunk system - public
         // Paper start - Anti-Xray
         final boolean shouldModify = level.chunkPacketBlockController.shouldModify(connection.player, chunk);
-        connection.send(new ClientboundLevelChunkWithLightPacket(chunk, level.getLightEngine(), null, null, shouldModify));
+        // Pufferfish start - Async Chunk Sending
+        if (gg.pufferfish.pufferfish.PufferfishConfig.enableAsyncChunkSending && !shouldModify && gg.pufferfish.pufferfish.async.AsyncChunkSend.POOL != null) {
+            ClientboundLevelChunkWithLightPacket packet = new ClientboundLevelChunkWithLightPacket(chunk, level.getLightEngine());
+            connection.send(packet);
+            gg.pufferfish.pufferfish.async.AsyncChunkSend.POOL.execute(() -> {
+                try {
+                    packet.finishAsyncSerialization();
+                } catch (Throwable throwable) {
+                    LOGGER.error("Failed to serialize chunk {} for async sending, kicking {}", chunk.getPos(), connection.player.getScoreboardName(), throwable);
+                    net.minecraft.server.MinecraftServer.getServer().execute(() -> connection.disconnect(net.minecraft.network.chat.Component.literal("Chunk serialization failed")));
+                }
+            });
+        } else {
+            connection.send(new ClientboundLevelChunkWithLightPacket(chunk, level.getLightEngine(), null, null, shouldModify));
+        }
+        // Pufferfish end - Async Chunk Sending
         // Paper end - Anti-Xray
         // Paper start - PlayerChunkLoadEvent
         if (io.papermc.paper.event.packet.PlayerChunkLoadEvent.getHandlerList().getRegisteredListeners().length > 0) {

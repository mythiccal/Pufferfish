+    private EntityCollectionBySection getOrCreateClassCollection(final Class<? extends Entity> clazz) {
+        this.collectionLock.lock();
+        try {
+            EntityCollectionBySection collection = this.entitiesByClass.get(clazz);
+            if (collection == null) {
+                final Reference2ObjectOpenHashMap<Class<? extends Entity>, EntityCollectionBySection> copy = new Reference2ObjectOpenHashMap<>(this.entitiesByClass);
